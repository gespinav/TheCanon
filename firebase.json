{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".claude/**",
      ".firebase/**",
      "**/node_modules/**",
      "functions/**",
      "index.html.bak.*",
      "index.html.pre-*",
      "*.md",
      "firestore.rules",
      "firestore.indexes.json",
      "google-cloud-sdk/**"
    ]
  }
}
